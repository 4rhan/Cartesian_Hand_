<!-- Scene around the generated hand model: floor, lights, cameras.
     cartesian_hand.xml is generated and must not be hand-edited, so everything
     that is not the hand lives here and includes it (MuJoCo Menagerie layout).
     Run with:  python -m cartesian_hand.sim --task zero --xml assets/cartesian_hand/scene.xml -->
<mujoco model="cartesian_hand_scene">
  <include file="cartesian_hand.xml" />

  <!-- The hand is ~180 x 110 x 80 mm, centred near (40, 0, 22) mm. -->
  <statistic center="0.04 0 0.02" extent="0.25" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="960" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0.04 0 0.6" dir="0 0 -1" directional="true" />
    <light pos="0.4 -0.4 0.5" dir="-1 1 -1.2" diffuse="0.4 0.4 0.4" />

    <!-- Lowest hand geometry sits at z = -16.7 mm; the floor goes 1 mm under it. -->
    <geom name="floor" type="plane" pos="0 0 -0.0177" size="0 0 0.05" material="groundplane"
          contype="1" conaffinity="1" />

    <!-- Fixed views for recording; names are what mujoco.Renderer takes. -->
    <camera name="front" pos="0.40 0 0.15" xyaxes="0 1 0 -0.35 0 1" fovy="45" />
    <camera name="side" pos="0.04 -0.38 0.15" xyaxes="1 0 0 0 0.37 1" fovy="45" />
    <camera name="top" pos="0.04 0 0.45" xyaxes="1 0 0 0 1 0" fovy="45" />
  </worldbody>
</mujoco>
